# Required on the web service: dispatch workflow tasks
RENDER_API_KEY=rnd_your_render_api_key

# Required on the workflow service: Mastra model router
# Format: provider/model-name (example: openai/gpt-4o-mini)
MASTRA_MODEL=openai/gpt-4o-mini

# Provider key matching MASTRA_MODEL (set on the workflow service)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the default workflow slug
WORKFLOW_SLUG=render-workflows-mastra-workflow

# Optional: how often the web service polls task status (ms)
POLL_INTERVAL_MS=3000

# Optional: server port (Render sets this automatically)
PORT=3000
